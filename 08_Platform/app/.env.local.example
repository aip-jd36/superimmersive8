# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Configuration (REQUIRED - get from https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# Email Configuration
RESEND_API_KEY=your-resend-api-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=admin@superimmersive8.com

# Numbers Protocol — Assessment Service v1.0
# Server-side only. Never expose this key to client components.
# Obtain from Numbers Protocol (contact Sofia Yan — see call notes Jul 1, 2026).
# Add to Vercel env vars as: NUMBERS_API_KEY (server-side, no NEXT_PUBLIC_ prefix).
# Leave empty in development to use MockProvenanceProvider automatically.
NUMBERS_API_KEY=

# Interview Engine — CRC Prototype Alpha, Phase 6a substage 2
# Server-side only, local evaluation use only. Never exposed to client
# components, never used by the Next.js app or the Jest unit-test suite.
# Required only to run: npm run eval:extraction
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5 if unset.
INTERVIEW_EXTRACTOR_MODEL=claude-sonnet-5

# Interview Engine — CRC Prototype Alpha, Phase 6b
# Same ANTHROPIC_API_KEY above is reused. Separate model setting -- kept
# independent from INTERVIEW_EXTRACTOR_MODEL since Extraction and
# candidate-question generation are two independently-tunable jobs, not one.
# Optional. Defaults to claude-sonnet-5 if unset.
INTERVIEW_CANDIDATE_QUESTION_MODEL=claude-sonnet-5

# Interview Engine — CRC Prototype Alpha, Phase 6c (Constraint A)
# Same ANTHROPIC_API_KEY above is reused. Separate model setting, same
# reasoning as INTERVIEW_CANDIDATE_QUESTION_MODEL above.
# Optional. Defaults to claude-sonnet-5 if unset.
INTERVIEW_CONSTRAINT_A_MODEL=claude-sonnet-5
