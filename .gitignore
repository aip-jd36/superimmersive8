# Environment variables (contains API secrets)
.env.local
.env*.local

# Credentials file (contains API tokens)
CREDENTIALS.txt

# Vercel
.vercel

# Audio/video files (large binaries — store locally, do not commit)
*.m4a
*.mp3
*.mp4
*.wav
*.mov

# OS files
.DS_Store
*.log

# Node modules (if you add npm packages later)
node_modules/

# GA4 OAuth token file (refresh token stored as GitHub secret instead)
tools/ga4_token.json

# Downloaded archives
*.tar.gz

# Python cache
__pycache__/
*.pyc

# Supabase CLI machine-local state (CR-V2-DOC-2C-OPS-2): the link to a project (project-ref, pooler-url) and
# cached service versions. Never commit it: a tracked link makes every clone target that project by default.
08_Platform/supabase/.temp/
